# ========== 推荐：自建后端代理（Key 在服务端，见 /server 目录）==========
# 前端只填代理根 URL，不要填 sk- Key
VITE_OPENAI_PROXY_URL=http://localhost:8787

# ========== 不推荐：直连 OpenAI（Key 会打进前端包，仅本地调试）==========
# VITE_OPENAI_KEY=

# 可选：模型 ID，默认 gpt-4o-mini
# VITE_OPENAI_MODEL=gpt-4o-mini

# 可选：仅在「未配置 VITE_OPENAI_PROXY_URL」且「直连」时使用
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
